# Скопируйте в frontend/.env.local и вставьте ключи.
# После правки .env.local перезапустите `npm run dev`.
# https://developer.tech.yandex.ru/ — в ограничениях каждого ключа укажите HTTP Referer сайта (домены без порта и без http://).

# Ключ «JavaScript API» — рисует карту (обязателен).
VITE_YANDEX_MAPS_KEY=

# Ключ «API Поиска по организациям» — список ЖЭС, паспортных столов, военкоматов и т.д. (необязателен).
# Если ключ не задан или не принят, список берётся из OpenStreetMap.
VITE_YANDEX_SEARCH_KEY=
