# Скопируйте в frontend/.env.local и вставьте ключи.
# После правки .env.local перезапустите `npm run dev`.
# https://developer.tech.yandex.ru/ — в ограничениях каждого ключа укажите HTTP Referer сайта (localhost:5173 и боевой домен).

# Ключ «JavaScript API» — рисует карту.
VITE_YANDEX_MAPS_KEY=

# Ключ «API Поиска по организациям» — список ЖЭС, паспортных столов, военкоматов и т.д.
# Если не задан, поиск пробует использовать ключ карты.
VITE_YANDEX_SEARCH_KEY=
