# Скопируй в .env и заполняй по мере необходимости: cp .env.example .env

APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# Токен от @BotFather. Пока пусто — REST API работает, бот не стартует.
TELEGRAM_BOT_TOKEN=

DATABASE_URL=postgresql://darechy:darechy@localhost:5432/darechy
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Локальная LLM: brew install ollama && ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b

# Эмбеддинги (dense-плечо поиска): модель в Ollama и размерность вектора
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIM=1024

# RAG: порог релевантности сырых скоров (BM25/косинус) и включение dense-плеча
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.05
USE_QDRANT=true

# Голос (неделя 3)
WHISPER_MODEL=large-v3-turbo
TTS_LANG=ru

# Langfuse (опционально): docker compose --profile langfuse up -d
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
