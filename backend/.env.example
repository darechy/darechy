# Скопируй в .env и заполняй по мере необходимости: cp .env.example .env

APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# Отдельный процесс бота: python -m app.bot.telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=http://127.0.0.1:8000
TELEGRAM_API_KEY=

DATABASE_URL=postgresql://darechy:darechy@localhost:5432/darechy
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Локальная LLM: brew install ollama && ollama pull qwen3:1.7b
# 1.7b, а не 4b/8b: на 8 ГБ RAM большая модель вместе с эмбеддингами уходит в своп.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Эмбеддинги (dense-плечо поиска): модель в Ollama и размерность вектора.
# bge-m3 = 1024. Модель `multilingual-e5-large` в библиотеке Ollama отсутствует.
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Сколько Ollama держит модель в памяти после запроса. Чат выгружаем быстро —
# на 8 ГБ ему не место рядом с эмбеддингами; эмбеддинги греются чаще, им дольше.
CHAT_KEEP_ALIVE=30s
EMBED_KEEP_ALIVE=5m

# Прогрев Qwen в фоне после запуска API.
WARMUP_ON_START=true
AI_ROUTER=false

# RAG: порог релевантности сырых скоров (BM25/косинус) и включение dense-плеча
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.05
USE_QDRANT=true

# Голос (неделя 3)
WHISPER_MODEL=large-v3-turbo
TTS_LANG=ru

# Langfuse (опционально): docker compose --profile langfuse up -d
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Админка: правка базы знаний, услуг и доучить модель без кода.
# Открывается на http://localhost:8000/api/admin. Задайте случайный токен.
ADMIN_TOKEN=

# Individual admin tokens, keyed by the public author name. Use unique secrets.
ADMIN_ACCOUNTS={}
NEWS_DB=news.sqlite3
